{# Base skeleton shared by every page.
 #
 # Head boilerplate (icons, PWA manifest, viewport policy) lives here so a
 # second page would not have to copy it. The stylesheets/javascripts blocks
 # let pages add their own entries below the shared ones. #}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    {# viewport-fit=cover: the dashboard is used one-handed on a phone, so
       it must reach into the notch/home-indicator safe areas. Zoom is NOT
       locked here (WCAG 1.4.4) — the iOS focus auto-zoom it used to
       suppress is fixed at the source instead, by keeping every form
       control at >=16px in app.css (GUIDING-LIGHT §3.3a). #}
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{% block title %}VitalPulse Dashboard{% endblock %}</title>
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="VitalPulse" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="theme-color" content="#1e3a5f" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="stylesheet" href="/app.css" />
    {% block stylesheets %}{% endblock %}
</head>
<body>
    {% block body %}{% endblock %}
    {% block javascripts %}{% endblock %}
</body>
</html>
