# ─────────────────────────────────────────────────────────────
# VitalPulse — default environment configuration (committed)
#
# This file contains SAFE DEFAULTS ONLY. Never put real secrets here.
# For local overrides, copy the values you need to change into
# .env.local (which is git-ignored), e.g.:
#
#     cp host.env .env.local        # Docker workflow
#     # or create .env.local by hand
#
# Loading order (later wins): .env → .env.local → .env.$APP_ENV →
# .env.$APP_ENV.local — real environment variables beat all files.
# ─────────────────────────────────────────────────────────────

###> symfony/framework-bundle ###
APP_ENV=prod
APP_SECRET=change_me_generate_with_openssl_rand_hex_32
###< symfony/framework-bundle ###

###> symfony/routing ###
# Used when generating URLs outside an HTTP request (CLI, etc.)
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
# SQLite (default — zero config, database file in var/data/)
DATABASE_URL="sqlite:///%kernel.project_dir%/var/data/health_tracker.db"

# MySQL (alternative — uncomment and set credentials)
# DATABASE_URL="mysql://user:password@127.0.0.1:3306/vitals?serverVersion=8.0&charset=utf8mb4"
###< doctrine/doctrine-bundle ###

###> vital-pulse ###
# Admin API key required for all /api/v1/* endpoints.
# Generate a strong one: openssl rand -hex 32
API_KEY=change_me_generate_with_openssl_rand_hex_32

# Optional read-only API key (GET/HEAD only; cannot create, update, delete).
# Generate a separate strong one: openssl rand -hex 32
# Leave unset/empty for single-admin-key mode.
#READ_ONLY_API_KEY=change_me_generate_with_openssl_rand_hex_32

# Port to expose the app on (Docker only, defaults to 8080)
VITALPULSE_PORT=8080

# Default for the dashboard reading-entry warnings toggle (high/normal/etc.
# hints shown while entering a new reading). 1 = enabled (default), 0 = disabled.
# Users can still toggle per browser; the browser preference wins over this.
READING_WARNINGS_ENABLED=1
###< vital-pulse ###
