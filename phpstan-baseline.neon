			identifier: missingType.iterableValue
			count: 1
			path: src/Controller/HealthApiController.php

		-
			message: '#^Property App\\Entity\\HealthLog\:\:\$id \(int\|null\) is never assigned int so it can be removed from the property type\.$#'
			identifier: property.unusedType
			count: 1
			path: src/Entity/HealthLog.php

