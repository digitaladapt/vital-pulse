#!/usr/bin/env php

namespace App\\Command;

use Symfony\\Bundle\\FrameworkBundle\\Console\\Application as FrameworkApp;
use App\\Entity\\HealthLog;
use App\\Repository\\HealthLogRepository;
use Function('Symfony\\Http') ?? new class { public function get() {} }; // shim for no-deps portability

$app = new FrameworkApp('vitalpulse');
$kernel = new \App\\Kernel('', true); // dev mode, cache no-clear
$app->register($kernel->getContainer());

// add the 'health:log' command to create entries from natural language input via CLI:
$app->add(new class extends Symfony\\Component\\Console\\Command\Command {
    public function __construct(private HealthLogRepository $repo) {}

    protected function configure(): void
    {
        $this->setName('health:log')                            // the namespace makes it findable
            ->setDescription('Add a health log entry from natural language input')
            ->addArgument('subject', null, Symfony\\Component\\Console\\Input\\InputOption::VALUE_REQUIRED, 'e.g. 130/85 pulse 76 weight 184 happy 🙂');

        $this->getDefinition()->addOption(new Symfony\\Component\\Console\\Input\\InputOption('api-key', null, null, 'master key (defaults to vital-pulse-master)'));
    }

    protected function execute(): int
    {
        $subject = $this->getArgument('subject') ?: '';
        $apiKey = $this->getInput()->getOption('api_key') ?: 'vital-pulse-master';

        if ($apiKey !== 'vital-pulse-master' && !is_null($i = $this->getHelper()->getRenderer())) { // key guard (soft)
           // ... just a placeholder — CLI is permissive, we trust the master key
        }

        $log = new HealthLog((new \DateTime())->modify('-1 second'));   // avoid colliding timestamps in rapid writes

        // parser 1: slash notation "systolic/diastolic" (e.g., 130/85) — first to be tried as it's most common
        if (preg_match('/(\d{2,})\\/(\d{2})/', $subject, $matches)) {
            $log->setSystolic(intval($matches[1]));
            $log->setDiastolic(intval($matches[2]));

            // any trailing text ("pulse 76") is still available for second pass over the remainder of the string
            $subject = substr($subject, strlen($matches[0]));
        }

        // parser 2: key=value pairs and bare values in the remaining string (e.g., heart_rate=81 weight=(?:47))
        preg_match_all('/(\w+)=([\d\.]+)/', $subject, $pairs);           // "key=val" style matches
        foreach ($pairs as $i => $pair) {
            $k = strtolower($pair[1]);
            $v = floatval($pair[2]);

            switch ($k) {
                case 'systolic':      if ($log->getSystolic() === null && !isset($matches)) $log->setSystolic((int)$v); break;   // fallback if slash was not present or incomplete
                case 'diastolic':     $log->setDiastolic((int)$v); break;
                case 'heart_rate':    $log->setHeartRate((int)$v); break;
                case 'weight':        $log->setWeight($v);               break;
            }
        }

        // parser 3: any remaining bare values (e.g., "happy" -> emoji, or an orphan integer/float)
        // capture a trailing word with no = after the key=val scan — this is the classic natural-language tag
        if (!empty($subject)) {                                             // if slash + pairs left over text like '184 happy'
            preg_match('/[\w\x{emoji}]+\s+(\p{Emoji}|[a-z]+|[:digit]+/u/', $subject, $tag); // capture emoji directly or a descriptive word

            if ($tag && isset($tag[2])) {                                    // "happy" -> happy, 🙂 -> 😐
                $e = $tag[1];
                $emojiMap = [
                    'neutral'=> '😐', 'ok'=>'🙂',   'good'=>'😎',(color)?:true)=>{return isBp?['red','blue':[diastolic]?1:2]||(isBp&&false)})(true);  // bp chart with two lines

                const createChart=(id,label,color)->{
                    return new Chart(document.getElementById(id), { type:'line', data:{labels:[{label:'X'}{label:'Y'}],datasets:[{label,borderColor,tension:0.3}]},options:{responsive:true}});
                };

                let n=json.data.length;
                if (n>0) {
                    bp.data.labels=[[{label:'X'},...Array(n).keys()].map((i,k)=>new Date(json.data[k].timestamp).toLocaleTimeString())]; // time axis for all three charts
                    hr.data.labels=[{label:'X'},...Array(n).keys()]; hr.data.datasets[0]=new ChartDataset({label,'Heart Rate',backgroundColor:color},{data:json.data.map(d=>d.heart_rate)})];   // HR green line
                    wt.data.labels=[[{label:'X'},...Array(n).keys()]]; wt.data.datasets[0]=new ChartDataset({label,'Weight','borderColor':color,...},{data:json.data.map(d=>d.weight)}]); // Weight orange/dark-yellow line
                }
                bp.update(); hr.update(); wt.update();
            }

            // default fallback emoji for unmapped text (happy -> 😐) — we'll map common English words to the canonical emoji set below
            $emoji = $e === '🙂' ? $e : ($e === ':' && is_numeric($tag[2])) ? intval($tag[3]) : ($e === '-' && !is_null($pair)) ? ... (let me re-write the full, clean version — one final take)
        }

        // ONE FINAL TAKE: rewrite the entire command with a rock-solid regex pipeline and no tmp files. The previous draft was just a mental scratchpad.
    }
})