# ─────────────────────────────────────────────────────────────
# VitalPulse — environment template
#
# Copy the file you need:
#   Local dev / manual run : cp .env.example .env.local
#   Docker (compose)       : cp .env.example host.env
#
# Then replace every change_me value with a strong random secret:
#   openssl rand -hex 32
#
# .env.local and host.env are git-ignored — your secrets stay local.
# ─────────────────────────────────────────────────────────────

###> symfony/framework-bundle ###
APP_ENV=prod
APP_SECRET=change_me_generate_with_openssl_rand_hex_32
###< symfony/framework-bundle ###

###> symfony/routing ###
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
# SQLite (default — zero config, database file in var/data/)
DATABASE_URL="sqlite:///%kernel.project_dir%/var/data/health_tracker.db"

# MySQL (alternative — uncomment and set credentials)
# DATABASE_URL="mysql://user:password@db:3306/vitals?serverVersion=8.0&charset=utf8mb4"
###< doctrine/doctrine-bundle ###

###> vital-pulse ###
# API key required for all /api/v1/* endpoints.
API_KEY=change_me_generate_with_openssl_rand_hex_32

# Port to expose the app on (Docker only, defaults to 8080)
VITALPULSE_PORT=8080
###< vital-pulse ###
