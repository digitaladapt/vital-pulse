		-
			message: '#^Method App\\Repository\\HealthLogRepository\:\:findByDateRange\(\) has parameter \$emojis with no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: src/Repository/HealthLogRepository.php

