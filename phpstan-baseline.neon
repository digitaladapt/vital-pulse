			identifier: missingType.iterableValue
			count: 1
			path: src/Repository/HealthLogRepository.php

		-
			message: '#^Call to static method PHPUnit\\Framework\\Assert\:\:assertNotNull\(\) with DateTimeImmutable\|false will always evaluate to true\.$#'
			identifier: staticMethod.alreadyNarrowedType
			count: 2
			path: tests/Controller/HealthApiControllerTest.php

		-
			message: '#^Class App\\Tests\\Controller\\HealthApiControllerTest has an uninitialized property \$client\. Give it default value or assign it in the constructor\.$#'
			identifier: property.uninitialized
			count: 1
			path: tests/Controller/HealthApiControllerTest.php

		-
			message: '#^Class App\\Tests\\Controller\\HealthApiControllerTest has an uninitialized property \$em\. Give it default value or assign it in the constructor\.$#'
			identifier: property.uninitialized
			count: 1
			path: tests/Controller/HealthApiControllerTest.php

