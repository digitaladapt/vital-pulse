			identifier: property.uninitialized
			count: 1
			path: tests/Controller/SystemControllerTest.php

		-
			message: '#^Class App\\Tests\\Controller\\SystemControllerTest has an uninitialized property \$em\. Give it default value or assign it in the constructor\.$#'
			identifier: property.uninitialized
			count: 1
			path: tests/Controller/SystemControllerTest.php

		-
