# --- vital-pulse — documented environment template ---------------------------
#
# Every variable the app reads, with its default and what happens if you leave
# it out (GUIDING-LIGHT §4.4).
#
# Copy it to one of these, depending on how you run the app:
#
#   Docker / compose : cp docs/examples/.env.example host.env
#   Local dev        : cp docs/examples/.env.example .env.local
#
# `.env`, `.env.local` and `host.env` are all gitignored. Only `.env.example`
# and `.env.test` are tracked (GUIDING-LIGHT §5.1) — real secrets never enter
# git history.
#
# Generate a strong secret with:  openssl rand -hex 32

# ── Required in production ───────────────────────────────────────────────────

# Symfony's application secret. Used to sign sessions and CSRF tokens.
# REQUIRED. There is deliberately no usable default here: the app used to ship
# a committed `.env` whose placeholder was silently accepted, which meant it
# could boot in production with a known APP_SECRET.
APP_SECRET=change_me_generate_with_openssl_rand_hex_32

# Admin API key for every /api/v1/* endpoint. Full read/write access.
# REQUIRED. Sent by clients in the `X-API-Key` header.
API_KEY=change_me_generate_with_openssl_rand_hex_32

# Public base URL of this deployment, used to generate absolute URLs outside a
# request (CLI commands, emails). REQUIRED for correct absolute URLs.
DEFAULT_URI=http://localhost

# ── Optional ─────────────────────────────────────────────────────────────────

# A second, restricted key: GET/HEAD only, cannot create, update or delete.
# Leave unset to run with a single admin key.
#READ_ONLY_API_KEY=change_me_generate_with_openssl_rand_hex_32

# Doctrine connection URL. Defaults to SQLite in var/data/, which is what the
# Docker image and the compose example use, so in practice you can omit it.
# MySQL: DATABASE_URL="mysql://user:password@127.0.0.1:3306/vitals?serverVersion=8.0&charset=utf8mb4"
DATABASE_URL="sqlite:///%kernel.project_dir%/var/data/health_tracker.db"

# Host port published by compose (container always listens on 80).
VITALPULSE_PORT=8080

# Deployment-wide default for the dashboard's reading-entry warnings.
# 1 = enabled (default), 0 = disabled. A user's own browser preference always
# wins over this once they have toggled it. Served to the dashboard by
# GET /api/about.
READING_WARNINGS_ENABLED=1

# ── Deployment-time only ─────────────────────────────────────────────────────

# Image repository used by docs/examples/compose.yaml, e.g.
#   digitaladapt/vitalpulse
# Not read by the application itself.
#DOCKERHUB_TARGET=
