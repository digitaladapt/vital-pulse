parameters:
	ignoreErrors:
		-
			message: '#^Method App\\Controller\\HealthApiController\:\:formatMetricStats\(\) has parameter \$stats with no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: src/Controller/HealthApiController.php

		-
			message: '#^Method App\\Controller\\HealthApiController\:\:formatMetricStats\(\) return type has no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: src/Controller/HealthApiController.php

		-
			message: '#^Method App\\Controller\\HealthApiController\:\:serializeAggregatedLog\(\) has parameter \$row with no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
